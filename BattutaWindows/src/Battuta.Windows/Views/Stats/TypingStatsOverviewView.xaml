<UserControl x:Class="Battuta.Windows.Views.Stats.TypingStatsOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Battuta.Windows.Controls"
             xmlns:stats="clr-namespace:Battuta.Windows.Views.Stats"
             Background="Transparent"
             SizeChanged="OverviewSizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentStack" Margin="20" MaxWidth="1080" HorizontalAlignment="Stretch">
            <Grid x:Name="TopLayout" Height="410">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="58*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                        <Grid>
                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="今日字符" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TodayCharactersText" Text="0" FontSize="42" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                                    <TextBlock Text="字符" Margin="6,20,0,0" Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="按字符键触发估算" VerticalAlignment="Bottom" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                        <Grid>
                            <TextBlock Text="&#xECAA;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="最多应用" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            <TextBlock x:Name="TopApplicationNameText" Text="暂无" VerticalAlignment="Center" FontSize="26" FontWeight="Bold"
                                       TextWrapping="Wrap" MaxHeight="70" />
                            <TextBlock x:Name="TopApplicationCountText" Text="0 个字符" VerticalAlignment="Bottom" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                        <Grid>
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="今日峰值" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PeakCpsText" Text="0" FontSize="42" FontWeight="Bold" />
                                <TextBlock Text="字/秒" Margin="6,20,0,0" Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="LastInputText" Text="最近输入 --:--" VerticalAlignment="Bottom" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                        <Grid>
                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="活跃时间" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            <TextBlock x:Name="ActiveTimeText" Text="0 秒" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ActiveMinutesText" Text="0 个输入分钟" VerticalAlignment="Bottom" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Style="{DynamicResource Battuta.Card}" CornerRadius="20" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <controls:SectionHeading x:Name="TrendHeading" Title="输入趋势" Subtitle="最近 1 小时 · 每格 1 分钟" Glyph="&#xE9D9;" />
                            <Border HorizontalAlignment="Right" Style="{DynamicResource Battuta.SegmentPanel}" Width="196">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="SevenDaysRange" GroupName="TimelineRange" Content="7d" Style="{DynamicResource Battuta.Segment}" Padding="4,5" Checked="TimelineRangeChanged" />
                                    <RadioButton x:Name="TwentyFourHoursRange" GroupName="TimelineRange" Content="24h" Style="{DynamicResource Battuta.Segment}" Padding="4,5" Checked="TimelineRangeChanged" />
                                    <RadioButton x:Name="SixHoursRange" GroupName="TimelineRange" Content="6h" Style="{DynamicResource Battuta.Segment}" Padding="4,5" Checked="TimelineRangeChanged" />
                                    <RadioButton x:Name="OneHourRange" GroupName="TimelineRange" Content="1h" Style="{DynamicResource Battuta.Segment}" Padding="4,5" IsChecked="True" Checked="TimelineRangeChanged" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,6">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock x:Name="TrendTotalText" Text="0" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" FontFamily="Cascadia Mono" />
                                <TextBlock Text="总计" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TrendPeakText" Text="0" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" FontFamily="Cascadia Mono" />
                                <TextBlock Text="单格峰值" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="2" MinHeight="180">
                            <stats:StatsTrendChart x:Name="Trend" />
                            <StackPanel x:Name="TrendEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⌨" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Battuta.AccentStrongBrush}" />
                                <TextBlock Text="这一时段还没有输入" Margin="0,8,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="开始打字后，曲线会立即出现。" Margin="0,3,0,0" Style="{DynamicResource Battuta.CaptionText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="今日鼠标点击" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TodayMouseClicksText" Text="0" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                                <TextBlock Text="次" Margin="6,14,0,0" Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Viewbox>
                        <TextBlock Text="每次按下计 1 次，包含侧键" Style="{DynamicResource Battuta.Caption2Text}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource Battuta.InstrumentCard}" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                            <TextBlock Text="累计鼠标点击" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" />
                        </Grid>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,8,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AllTimeMouseClicksText" Text="0" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display" />
                                <TextBlock Text="次" Margin="6,14,0,0" Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Viewbox>
                        <TextBlock Text="自启用统计以来的点击总数" Style="{DynamicResource Battuta.Caption2Text}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,16,0,0" Style="{DynamicResource Battuta.Card}" CornerRadius="20">
                <StackPanel>
                    <Grid Margin="16">
                        <controls:SectionHeading x:Name="TimelineHeading" Title="应用时间线" Subtitle="最近 1 小时 · 每格 1 分钟" Glyph="&#xED14;" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Battuta.AccentSoftBrush}" CornerRadius="12" Padding="10,5">
                            <TextBlock x:Name="ApplicationCountText" Text="0 个应用" Style="{DynamicResource Battuta.CaptionText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Battuta.AccentStrongBrush}" />
                        </Border>
                    </Grid>
                    <Separator />
                    <Grid Margin="16,10,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="应用" Style="{DynamicResource Battuta.Caption2Text}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="区间" HorizontalAlignment="Right" Style="{DynamicResource Battuta.Caption2Text}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="输入时间线" Style="{DynamicResource Battuta.Caption2Text}" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="TimelineEmptyState" Text="最近 1 小时还没有应用输入。" Margin="16,18" HorizontalAlignment="Center"
                               Style="{DynamicResource Battuta.CaptionText}" />
                    <stats:StatsAppTimeline x:Name="Timeline" Margin="16,0,16,12" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
